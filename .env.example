# Copy to .env.local and fill in. The app runs with only OPENAI_API_KEY set:
# Supabase enables the cache, registry, history and rate limits; Clerk enables
# sign-in. Anything left blank is treated as absent, not as an empty value, and
# the affected feature switches itself off rather than erroring.

# Required — the analysis itself.
OPENAI_API_KEY=

# Optional — cache, public registry, saved history, rate limiting.
# The URL is NEXT_PUBLIC_ because the client needs it; the keys are not.
# Prefer the secret (service-role) key. Without it the app falls back to the
# publishable key, which works because supabase/schema.sql grants the anon role
# what it needs — but RLS then applies, so writes are limited to what those
# policies allow.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional — sign-in and saved history. With these unset the sign-in UI does
# not render at all, rather than rendering a button that cannot work.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
